{
  "name": "takeoff-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Construction drawing measurement, markup and quantity takeoff workspace (Bluebeam Revu-style).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sample": "node scripts/generate-sample.mjs",
    "build:artifact": "node scripts/build-artifact.mjs",
    "example": "node scripts/generate-example.mjs"
  },
  "dependencies": {
    "lucide-react": "0.460.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
